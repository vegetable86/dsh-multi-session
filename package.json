{
    "name":  "@local/dsh-multi-session",
    "version":  "0.13.0",
    "description":  "Multi-session split view panel for DeepSeek Harness",
    "type":  "module",
    "keywords":  [
                     "dsh",
                     "dsh-bundle",
                     "dsh-plugin",
                     "deepseek-harness",
                     "multi-session",
                     "split-view"
                 ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "icon.png"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-api-session-controller",
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-ui-layout",
                                              "@deepseek-ai/dsh-client-ui-session",
                                              "@deepseek-ai/dsh-client-ui-sidebar",
                                              "@deepseek-ai/dsh-client-ui-workspace"
                                          ]
                           }
            },
    "scripts":  {
                    "test":  "node scripts/smoke.mjs && node scripts/render-smoke.mjs",
                    "release":  "node scripts/pack-release.mjs"
                },
    "devDependencies":  {
                            "@deepseek-ai/dsh-plugin-market-index":  "^0.2.1-alpha.4",
                            "jsdom":  "^29.1.1",
                            "react":  "^18.3.1",
                            "react-dom":  "^18.3.1"
                        },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/vegetable86/dsh-multi-session.git"
                   },
    "homepage":  "https://github.com/vegetable86/dsh-multi-session#readme",
    "author":  {
                   "name":  "vegetable86",
                   "url":  "https://github.com/vegetable86"
               },
    "license":  "MIT",
    "icon":  "icon.png"
}